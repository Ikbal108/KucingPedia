<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".activity_detail">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Motorcycle Image with rounded corners -->
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <ImageView
                android:id="@+id/motorImage"
                android:layout_width="240dp"
                android:layout_height="250dp"
                android:layout_gravity="center"
                android:contentDescription="Kucing Persia"
                android:scaleType="centerCrop"
                android:src="@drawable/kucingpersia" />
        </androidx.cardview.widget.CardView>

        <!-- Motorcycle Name -->
        <TextView
            android:id="@+id/motorName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="Kucing Persia"
            android:textColor="@color/black"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Description Label -->
        <TextView
            android:id="@+id/motorDescriptionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Deskripsi:"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Motorcycle Description -->
        <TextView
            android:id="@+id/motorDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Kucing berbulu panjang dengan wajah bulat dan hidung pesek. Memiliki mata besar dan ekspresi lembut."
            android:textColor="@color/black"
            android:textSize="14sp" />

        <!-- Specifications Label -->
        <TextView
            android:id="@+id/motorSpecificationsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Asal:"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Motorcycle Specifications -->
        <TextView
            android:id="@+id/motorSpecifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Iran (dahulu Persia)."
            android:textColor="@color/black"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
